# Unilead API - example environment configuration
# Copy this file to .env and adjust values as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite file path (relative to apps/api/). Created automatically on first run.
# For Postgres: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/unilead
DATABASE_URL=sqlite:///./unilead.db

# --- Auth (JWT) ---
# Generate a random secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- LLM provider ---
# One of: mock | ollama | openai
LLM_PROVIDER_TYPE=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (optional) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- AI Education default student session ---
STUDENT_ID=api-gateway-student
COURSE_ID=MEC271

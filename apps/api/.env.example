# Unilead API - example environment configuration
# Copy this file to .env and adjust values as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local dev (zero-config, SQLite file created on first run):
DATABASE_URL=sqlite:///./unilead.db

# Production — PostgreSQL (recommended). psycopg3 driver; create the DB first:
#   docker compose up -d postgres
# or connect to any existing Postgres instance, then apply the schema:
#   alembic upgrade head
# DATABASE_URL=postgresql+psycopg://unilead:unilead_dev@localhost:5432/unilead
# Backup (pg_dump) and migrate data from an existing SQLite file with:
#   apps/api/scripts/migrate.py (see its docstring)

# --- Auth (JWT) ---
# Generate a random secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Email verification ---
# email_backend: "log" prints codes to the server console (dev/demo);
#                "smtp" sends real emails (production).
EMAIL_BACKEND=log

# Used only when EMAIL_BACKEND=smtp.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM_EMAIL=unilead@example.com

# Verification code policy (seconds/minutes).
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5

# --- LLM provider ---
# One of: mock | ollama | openai
LLM_PROVIDER_TYPE=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (optional) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- AI Education default student session ---
STUDENT_ID=api-gateway-student
COURSE_ID=MEC271
